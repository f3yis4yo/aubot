# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=postgres://USER@localhost:5432/aubot
REDIS_URL=redis://localhost:6379/0

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# AUBOT_MONTHLY_BUDGET_USD=20
# AUBOT_CONFIDENCE_THRESHOLD=0.6
# AUBOT_INTENT_BACKEND=local        # local | tfidf | dialogflow
# AUBOT_SENTIMENT_BACKEND=vader     # vader | hf
# AUBOT_RETENTION_DAYS=90
# AUBOT_SESSION_RATE_LIMIT_PER_MINUTE=20   # raise for load tests or busy shared offices

# Production hardening (set behind HTTPS)
# DJANGO_DEBUG=0
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
